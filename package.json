{
  "name": "monerochan-wallet",
  "scripts": {
    "zipchrome": "(cd dist/chrome && zip -r ../chrome.zip .)",
    "copyfirefoxmanifest": "cp manifest/firefox.json dist/firefox/manifest.json",
    "copychromemanifest": "cp manifest/chrome.json dist/chrome/manifest.json",
    "firefox:background": "bun build background/background.ts --outdir dist/firefox --target browser",
    "firefox:content": "bun build content/content.ts --outdir dist/firefox --target browser",
    "firefox:sidebar": "bun build wallet/sidebar.html --outdir dist/firefox --target browser",
    "firefox:actionlog": "bun build wallet/actionlog.html --outdir dist/firefox --target browser",
    "buildfirefox": "bun run firefox:background && bun run firefox:content && bun run firefox:sidebar && bun run firefox:actionlog",
    "chrome:background": "bun build background/offscreen/background.html --outdir dist/chrome --target browser",
    "chrome:content": "bun build content/content.ts --outdir dist/chrome --target browser",
    "chrome:sw": "bun build background/offscreen/bridge.ts --outdir dist/chrome --target browser",
    "chrome:sidebar": "bun build wallet/sidebar.html --outdir dist/chrome --target browser",
    "chrome:actionlog": "bun build wallet/actionlog.html --outdir dist/chrome --target browser",
    "buildchrome": "bun run chrome:background && bun run chrome:sw && bun run chrome:sidebar && bun run chrome:actionlog && bun run chrome:content",
    "build": "bun run buildchrome && bun run copychromemanifest && bun run buildfirefox && bun run copyfirefoxmanifest",
    "clean": "rm -rf ./dist"
  },
  "devDependencies": {
    "@spirobel/monero-wallet-api": "../monero-wallet-api/typescript/",
    "@spirobel/seedphrase": "../monero-wallet-api/seedphrase/",
    "@types/bun": "1.3.14",
    "@types/chrome": "0.1.32"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  }
}
