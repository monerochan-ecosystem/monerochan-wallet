{
  "manifest_version": 2,
  "name": "monerochan wallet",
  "description": "Monerochan Wallet. Still fresh. Use only small amounts for now.",
  "version": "0.1.4",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "monerochan wallet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["<all_urls>", "unlimitedStorage", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "type": "module",
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob: 'unsafe-eval'; object-src 'self'"
}
